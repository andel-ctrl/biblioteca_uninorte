Cell id="m187" value="" style="endArrow=none;html=1;strokeColor=#555555;" edge="1" parent="1" source="m131" target="m186"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="m188" value="(0,N)" style="text;html=1;align=center;verticalAlign=middle;fontStyle=1;fontSize=13;fontColor=#B0002A;" vertex="1" parent="1"><mxGeometry x="1848.0" y="1712.0" width="70" height="22" as="geometry"/></mxCell><mxCell id="m189" value="" style="endArrow=none;html=1;strokeColor=#555555;" edge="1" parent="1" source="m72" target="m186"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="m190" value="(0,1)" style="text;html=1;align=center;verticalAlign=middle;fontStyle=1;fontSize=13;fontColor=#B0002A;" vertex="1" parent="1"><mxGeometry x="982.0" y="1746.0" width="70" height="22" as="geometry"/></mxCell><mxCell id="m191" value="cobra" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFE7A8;strokeColor=#B8860B;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1375.0" y="2027.0" width="150" height="76" as="geometry"/></mxCell><mxCell id="m192" value="" style="endArrow=none;html=1;strokeColor=#555555;" edge="1" parent="1" source="m131" target="m191"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="m193" value="(0,N)" style="text;html=1;align=center;verticalAlign=middle;fontStyle=1;fontSize=13;fontColor=#B0002A;" vertex="1" parent="1"><mxGeometry x="1883.109645098681" y="1757.6435870084092" width="70" height="22" as="geometry"/></mxCell><mxCell id="m194" value="" style="endArrow=none;html=1;strokeColor=#555555;" edge="1" parent="1" source="m85" target="m191"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="m195" value="(0,1)" style="text;html=1;align=center;verticalAlign=middle;fontStyle=1;fontSize=13;fontColor=#B0002A;" vertex="1" parent="1"><mxGeometry x="976.9951143428498" y="2227.3294929030744" width="70" height="22" as="geometry"/></mxCell><mxCell id="m196" value="&lt;b&gt;Notación de Chen&lt;/b&gt;&lt;br&gt;Rectángulo: entidad · Rombo: relación · Elipse: atributo&lt;br&gt;&lt;u&gt;&lt;b&gt;Subrayado&lt;/b&gt;&lt;/u&gt;: identificador · Elipse punteada: atributo derivado (se calcula, no se guarda)&lt;br&gt;(mín,máx): cuántas veces participa la entidad de ese lado&lt;br&gt;Círculo &lt;b&gt;d&lt;/b&gt;: especialización disjunta · Doble línea: total · &lt;b&gt;tipo&lt;/b&gt;: discriminador" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=10;fontSize=12;fillColor=#FFFFFF;strokeColor=#BBBBBB;" vertex="1" parent="1"><mxGeometry x="1790.0" y="2265.0" width="520" height="120" as="geometry"/></mxCell><mxCell id="m197" value="&lt;b&gt;Reglas que el diagrama no muestra por sí solo&lt;/b&gt;&lt;br&gt;· Todo usuario es exactamente un lector o un bibliotecario (total y disjunta). Lo disjunto lo garantiza la base con la llave foránea compuesta (id, tipo).&lt;br&gt;· turno (mañana, tarde o noche) es opcional y no está en el enunciado.&lt;br&gt;· &lt;b&gt;rol&lt;/b&gt; distingue estudiante y docente; no tienen atributos ni relaciones propias, por eso no son subtipos.&lt;br&gt;· Solo hay multa si la devolución fue tardía: monto = dias_retraso × valor_dia de la tarifa aplicada.&lt;br&gt;· nombres, apellidos, correo, nombre_usuario y contraseña se guardan en la cuenta de Django (auth_user)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacing=10;fontSize=12;fillColor=#FFF6DD;strokeColor=#C5A56A;" vertex="1" parent="1"><mxGeometry x="1790.0" y="1977.5" width="520" height="165" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>