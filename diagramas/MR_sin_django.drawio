0.5;html=1;startArrow=ERzeroToMany;endArrow=ERzeroToOne;startFill=0;endFill=0;strokeColor=#4A5568;strokeWidth=1.3;" edge="1" parent="1" source="c48" target="c71"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1640" y="467.0" /><mxPoint x="1640" y="681.0" /></Array></mxGeometry></mxCell><mxCell id="e94" style="edgeStyle=none;rounded=0;exitX=1;exitY=0.5;entryX=1;entryY=0.5;html=1;startArrow=ERzeroToOne;endArrow=ERmandOne;startFill=0;endFill=0;strokeColor=#4A5568;strokeWidth=1.3;" edge="1" parent="1" source="c55" target="c40"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1560" y="751.0" /><mxPoint x="1560" y="291.0" /></Array></mxGeometry></mxCell><mxCell id="e95" style="edgeStyle=none;rounded=0;exitX=1;exitY=0.5;entryX=0;entryY=0.5;html=1;startArrow=ERzeroToMany;endArrow=ERzeroToOne;startFill=0;endFill=0;strokeColor=#4A5568;strokeWidth=1.3;" edge="1" parent="1" source="c56" target="c71"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1665" y="773.0" /><mxPoint x="1665" y="681.0" /></Array></mxGeometry></mxCell><mxCell id="e96" style="edgeStyle=none;rounded=0;exitX=1;exitY=0.5;entryX=0;entryY=0.5;html=1;startArrow=ERzeroToMany;endArrow=ERzeroToOne;startFill=0;endFill=0;strokeColor=#4A5568;strokeWidth=1.3;" edge="1" parent="1" source="c64" target="c71"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1690" y="1043.0" /><mxPoint x="1690" y="681.0" /></Array></mxGeometry></mxCell><mxCell id="n97" value="&lt;b&gt;Restricciones CHECK, UNIQUE compuestas y llaves foráneas compuestas&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;bibliotecario&lt;/b&gt; · bibliotecario_tipo_fijo: &lt;font color=&quot;#555555&quot;&gt;tipo = 'bibliotecario'&lt;/font&gt;&lt;br&gt;&lt;b&gt;bibliotecario&lt;/b&gt; · bibliotecario_turno_valido: &lt;font color=&quot;#555555&quot;&gt;turno IN ('', 'manana', 'tarde', 'noche')&lt;/font&gt;&lt;br&gt;&lt;b&gt;ejemplar&lt;/b&gt; · ejemplar_estado_valido: &lt;font color=&quot;#555555&quot;&gt;estado IN ('disponible', 'prestado', 'perdido', 'mantenimiento')&lt;/font&gt;&lt;br&gt;&lt;b&gt;lector&lt;/b&gt; · lector_rol_valido: &lt;font color=&quot;#555555&quot;&gt;rol IN ('estudiante', 'docente')&lt;/font&gt;&lt;br&gt;&lt;b&gt;lector&lt;/b&gt; · lector_tipo_fijo: &lt;font color=&quot;#555555&quot;&gt;tipo = 'lector'&lt;/font&gt;&lt;br&gt;&lt;b&gt;libro&lt;/b&gt; · libro_anio_publicacion_check: &lt;font color=&quot;#555555&quot;&gt;anio_publicacion &amp;gt;= 0&lt;/font&gt;&lt;br&gt;&lt;b&gt;libro&lt;/b&gt; · libro_anio_publicacion_valido: &lt;font color=&quot;#555555&quot;&gt;(anio_publicacion &amp;gt;= 1000 AND anio_publicacion &amp;lt;= 2100)&lt;/font&gt;&lt;br&gt;&lt;b&gt;multa&lt;/b&gt; · multa_monto_positivo: &lt;font color=&quot;#555555&quot;&gt;monto &amp;gt; 0&lt;/font&gt;&lt;br&gt;&lt;b&gt;multa&lt;/b&gt; · multa_pago_coherente: &lt;font color=&quot;#555555&quot;&gt;((fecha_pago IS NOT NULL AND pagada) OR (fecha_pago IS NULL AND NOT pagada))&lt;/font&gt;&lt;br&gt;&lt;b&gt;prestamo&lt;/b&gt; · prestamo_aprobado_con_fechas: &lt;font color=&quot;#555555&quot;&gt;(estado IN ('pendiente', 'rechazado') OR (fecha_prestamo IS NOT NULL AND fecha_vencimiento IS NOT NULL))&lt;/font&gt;&lt;br&gt;&lt;b&gt;prestamo&lt;/b&gt; · prestamo_estado_valido: &lt;font color=&quot;#555555&quot;&gt;estado IN ('pendiente', 'activo', 'vencido', 'devuelto', 'rechazado', 'perdido')&lt;/font&gt;&lt;br&gt;&lt;b&gt;prestamo&lt;/b&gt; · prestamo_vencimiento_posterior: &lt;font color=&quot;#555555&quot;&gt;(fecha_prestamo IS NULL OR fecha_vencimiento IS NULL OR fecha_vencimiento &amp;gt;= fecha_prestamo)&lt;/font&gt;&lt;br&gt;&lt;b&gt;tarifa_multa&lt;/b&gt; · tarifa_multa_positiva: &lt;font color=&quot;#555555&quot;&gt;valor_dia &amp;gt; 0&lt;/font&gt;&lt;br&gt;&lt;b&gt;usuario&lt;/b&gt; · usuario_estado_valido: &lt;font color=&quot;#555555&quot;&gt;estado IN ('activo', 'bloqueado')&lt;/font&gt;&lt;br&gt;&lt;b&gt;usuario&lt;/b&gt; · usuario_tipo_valido: &lt;font color=&quot;#555555&quot;&gt;tipo IN ('lector', 'bibliotecario')&lt;/font&gt;&lt;br&gt;&lt;b&gt;usuario&lt;/b&gt; · UNIQUE (id, tipo): &lt;font color=&quot;#555555&quot;&gt;lo referencian las llaves compuestas de los subtipos&lt;/font&gt;&lt;br&gt;&lt;b&gt;libro_autor&lt;/b&gt; · UNIQUE (libro_id, autor_id): &lt;font color=&quot;#555555&quot;&gt;el par no se repite&lt;/font&gt;&lt;br&gt;&lt;b&gt;lector&lt;/b&gt; · lector_usuario_id_tipo_fkey: &lt;font color=&quot;#555555&quot;&gt;FOREIGN KEY (usuario_id, tipo) → usuario (id, tipo)&lt;/font&gt;&lt;br&gt;&lt;b&gt;bibliotecario&lt;/b&gt; · bibliotecario_usuario_id_tipo_fkey: &lt;font color=&quot;#555555&quot;&gt;FOREIGN KEY (usuario_id, tipo) → usuario (id, tipo)&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=10;fontSize=11;fillColor=#FFFBF0;strokeColor=#D9C9A3;" vertex="1" parent="1"><mxGeometry x="40" y="640" width="740" height="330" as="geometry" /></mxCell><mxCell id="n98" value="&lt;b&gt;Especialización total y disjunta&lt;/b&gt;&lt;br&gt;Todo usuario es exactamente un lector o un bibliotecario (discriminador &lt;b&gt;tipo&lt;/b&gt;). Cada subtipo guarda su tipo fijo y su llave foránea es &lt;b&gt;compuesta&lt;/b&gt;: (usuario_id, tipo) → usuario (id, tipo). Así la base impide que un usuario esté en los dos subtipos o en el que no le corresponde. Entre lectores, &lt;b&gt;rol&lt;/b&gt; distingue estudiante y docente." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFF6DD;strokeColor=#C5A56A;fontSize=11;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="2140" y="520" width="330" height="150" as="geometry" /></mxCell><mxCell id="n99" value="&lt;b&gt;Leyenda&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#B07D00&quot;&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt; llave primaria · &lt;font color=&quot;#1F5FA8&quot;&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; llave foránea · &lt;font color=&quot;#2E6B4F&quot;&gt;&lt;b&gt;UQ&lt;/b&gt;&lt;/font&gt; único · &lt;font color=&quot;#8F1D2C&quot;&gt;&lt;b&gt;CK&lt;/b&gt;&lt;/font&gt; CHECK · &lt;font color=&quot;#999999&quot;&gt;NULL&lt;/font&gt; admite vacío&lt;br&gt;Línea: pata de gallo en la tabla hija; O = opcional, | = obligatorio" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=top;spacing=8;strokeColor=#DDDDDD;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1720" y="870" width="370" height="80" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>